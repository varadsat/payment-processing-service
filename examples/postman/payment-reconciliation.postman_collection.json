{
  "info": {
    "name": "Payment Reconciliation Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "merchant_id", "value": "merchant_demo" },
    { "key": "merchant_name", "value": "Demo Merchant" },
    { "key": "txn_happy", "value": "txn-happy-001" },
    { "key": "txn_fail", "value": "txn-fail-001" },
    { "key": "txn_conflict", "value": "txn-conflict-001" },
    { "key": "txn_stuck", "value": "txn-stuck-001" },
    { "key": "txn_duplicate", "value": "txn-dup-001" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Happy Path (initiated → processed → settled)",
      "item": [
        {
          "name": "1. payment_initiated",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"happy-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. payment_processed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"happy-evt-002\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:01:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "3. settled  →  status=created, no conflict",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"happy-evt-003\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:02:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Duplicate Detection",
      "item": [
        {
          "name": "1. Original event  →  status=created",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"dup-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_duplicate}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T11:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. Same event_id again  →  status=duplicate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"dup-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_duplicate}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T11:00:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conflict: settled_after_fail",
      "item": [
        {
          "name": "1. payment_initiated",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"fail-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T12:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. payment_failed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"fail-evt-002\",\n  \"event_type\": \"payment_failed\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T12:01:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "3. settled on failed txn  →  conflict=settled_after_fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"fail-evt-003\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T12:02:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conflict: conflicting_transition (failed → processed)",
      "item": [
        {
          "name": "1. payment_initiated",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"conflict-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_conflict}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"300.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T13:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. payment_failed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"conflict-evt-002\",\n  \"event_type\": \"payment_failed\",\n  \"transaction_id\": \"{{txn_conflict}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"300.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T13:01:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "3. payment_processed on failed txn  →  conflict=conflicting_transition",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"conflict-evt-003\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{txn_conflict}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"300.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T13:02:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conflict: stuck_settlement (processed, no settlement, >24h old)",
      "item": [
        {
          "name": "1. payment_initiated  (old timestamp)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"stuck-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_stuck}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"2000.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T00:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. payment_processed  (old timestamp)  →  conflict=stuck_settlement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"stuck-evt-002\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{txn_stuck}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"2000.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T00:01:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Bulk Ingest",
      "item": [
        {
          "name": "POST /events/bulk  (3 events, 1 duplicate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events/bulk",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"event_id\": \"bulk-evt-001\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"txn-bulk-001\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"999.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-01-10T14:00:00+00:00\"\n  },\n  {\n    \"event_id\": \"bulk-evt-002\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"txn-bulk-002\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"450.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-01-10T14:01:00+00:00\"\n  },\n  {\n    \"event_id\": \"bulk-evt-001\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"txn-bulk-001\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"999.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-01-10T14:00:00+00:00\"\n  }\n]"
            }
          }
        }
      ]
    },
    {
      "name": "Validation Errors",
      "item": [
        {
          "name": "Missing required fields  →  422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-001\",\n  \"event_type\": \"payment_initiated\"\n}"
            }
          }
        },
        {
          "name": "Negative amount  →  422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-002\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"txn-bad-001\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"-100.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Naive timestamp (no timezone)  →  422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-003\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"txn-bad-002\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"100.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:00:00\"\n}"
            }
          }
        },
        {
          "name": "Bad currency format  →  422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-004\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"txn-bad-003\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"100.00\",\n  \"currency\": \"inr\",\n  \"timestamp\": \"2026-01-10T10:00:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "GET /transactions  (list all)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions"
          }
        },
        {
          "name": "GET /transactions  (filter by merchant)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?merchant_id={{merchant_id}}&limit=10",
              "query": [
                { "key": "merchant_id", "value": "{{merchant_id}}" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /transactions  (filter by payment_status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?payment_status=processed",
              "query": [
                { "key": "payment_status", "value": "processed" }
              ]
            }
          }
        },
        {
          "name": "GET /transactions  (pagination: page 1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?limit=5&offset=0",
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET /transactions  (pagination: page 2)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?limit=5&offset=5",
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET /transactions/:id  (happy path detail)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/{{txn_happy}}"
          }
        },
        {
          "name": "GET /transactions/:id  (conflict detail)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/{{txn_fail}}"
          }
        },
        {
          "name": "GET /transactions/:id  (404 on unknown)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/txn-does-not-exist"
          }
        }
      ]
    },
    {
      "name": "Reconciliation",
      "item": [
        {
          "name": "GET /reconciliation/summary  (group by merchant)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=merchant",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "group_by", "value": "merchant" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/summary  (group by merchant,status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=merchant,status",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "group_by", "value": "merchant,status" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/summary  (group by date)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=date",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "group_by", "value": "date" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/summary  (group by merchant,date,status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=merchant,date,status",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "group_by", "value": "merchant,date,status" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/summary  (with date range)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=merchant&from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [
                { "key": "group_by", "value": "merchant" },
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "GET /reconciliation/summary  (invalid group_by  →  400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/summary?group_by=foobar",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "group_by", "value": "foobar" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/discrepancies  (all conflicts)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/discrepancies",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "discrepancies"]
            }
          }
        },
        {
          "name": "GET /reconciliation/discrepancies  (stuck_settlement only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/discrepancies?reason=stuck_settlement",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "discrepancies"],
              "query": [{ "key": "reason", "value": "stuck_settlement" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/discrepancies  (settled_after_fail only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/discrepancies?reason=settled_after_fail",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "discrepancies"],
              "query": [{ "key": "reason", "value": "settled_after_fail" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/discrepancies  (conflicting_transition only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/discrepancies?reason=conflicting_transition",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "discrepancies"],
              "query": [{ "key": "reason", "value": "conflicting_transition" }]
            }
          }
        },
        {
          "name": "GET /reconciliation/discrepancies  (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reconciliation/discrepancies?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["reconciliation", "discrepancies"],
              "query": [
                { "key": "limit", "value": "10" },
