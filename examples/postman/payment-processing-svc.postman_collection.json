{
  "info": {
    "name": "Payment Processing Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://payment-processing-service.fly.dev" },
    { "key": "merchant_id", "value": "merchant_demo" },
    { "key": "merchant_name", "value": "Demo Merchant" },
    { "key": "txn_happy", "value": "" },
    { "key": "txn_duplicate", "value": "" },
    { "key": "dup_event_id", "value": "" },
    { "key": "txn_fail", "value": "" },
    { "key": "txn_conflict", "value": "" },
    { "key": "txn_stuck", "value": "" },
    { "key": "bulk_txn_1", "value": "" },
    { "key": "bulk_txn_2", "value": "" },
    { "key": "bulk_evt_dup", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Happy Path (initiated -> processed -> settled)",
      "item": [
        {
          "name": "1. payment_initiated",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('txn_happy', pm.variables.replaceIn('{{$randomUUID}}'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        },
        {
          "name": "2. payment_processed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        },
        {
          "name": "3. settled  ->  status=created, no conflict",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"{{txn_happy}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"1500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Duplicate Detection",
      "item": [
        {
          "name": "1. Original event  ->  status=created",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('txn_duplicate', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('dup_event_id', pm.variables.replaceIn('{{$randomUUID}}'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{dup_event_id}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_duplicate}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        },
        {
          "name": "2. Same event_id again  ->  status=duplicate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{dup_event_id}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_duplicate}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        }
      ]
    },
