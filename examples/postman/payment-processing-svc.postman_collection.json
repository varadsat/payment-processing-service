              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        },
        {
          "name": "2. payment_failed",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_failed\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        },
        {
          "name": "3. settled on failed txn  ->  conflict=settled_after_fail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"{{txn_fail}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"800.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            }
          }
        }
      ]
    },
