            }
          }
        }
      ]
    },
    {
      "name": "Conflict: stuck_settlement (intentionally old timestamps)",
      "item": [
        {
          "name": "1. payment_initiated  (timestamp >24h ago)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('txn_stuck', pm.variables.replaceIn('{{$randomUUID}}'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{txn_stuck}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"2000.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T00:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "2. payment_processed  (timestamp >24h ago)  ->  conflict=stuck_settlement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$randomUUID}}\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{txn_stuck}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"2000.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T00:01:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Bulk Ingest",
      "item": [
        {
          "name": "POST /events/bulk  (3 events, 1 duplicate)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('bulk_txn_1', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('bulk_txn_2', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('bulk_evt_dup', pm.variables.replaceIn('{{$randomUUID}}'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/events/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["events", "bulk"]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"event_id\": \"{{bulk_evt_dup}}\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"{{bulk_txn_1}}\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"999.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  },\n  {\n    \"event_id\": \"{{$randomUUID}}\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"{{bulk_txn_2}}\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"450.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  },\n  {\n    \"event_id\": \"{{bulk_evt_dup}}\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"{{bulk_txn_1}}\",\n    \"merchant_id\": \"{{merchant_id}}\",\n    \"merchant_name\": \"{{merchant_name}}\",\n    \"amount\": \"999.00\",\n    \"currency\": \"INR\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  }\n]"
            }
          }
        }
      ]
